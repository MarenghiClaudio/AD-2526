# =============================================================
# .env.worker.template — Template per le VM worker
#
# Per ogni worker:
#   1. Copia come .env nella root del progetto sul worker
#   2. Imposta MASTER_IP con l'IP privato della VM master
#   3. Imposta CACHE_STRATEGY con la strategia assegnata a questo worker
# =============================================================

# --- IP privato della VM master (PostgreSQL) ---
MASTER_IP=10.0.0.4

# --- Strategia di caching assegnata a questo worker ---
# Worker 1: no_cache      (baseline, nessun Redis)
# Worker 2: cache_aside   (lazy loading)
# Worker 3: write_through (scrittura sincrona su cache)
# Worker 4: push_feed     (feed pre-calcolato)
# Worker 5: hybrid        (strategia ibrida)
CACHE_STRATEGY=cache_aside

# --- Connessione al database (PostgreSQL sul master) ---
DB_USER=postgres
DB_PASSWORD=admin
DB_NAME=ad
DB_SCHEMA=ad
DB_PORT=5432
DB_POOL_MIN_CONN=2
DB_POOL_MAX_CONN=20

# --- Redis (locale al worker) ---
REDIS_PORT=6379
REDIS_DB=0

# --- TTL cache (secondi) ---
CACHE_TTL_USER=300
CACHE_TTL_POST=300
CACHE_TTL_TIMELINE=60
CACHE_TTL_FEED=60
CACHE_TTL_FEED_FOF=60

# --- FYP ranking ---
FYP_WEIGHT_RECENCY=1.0
FYP_WEIGHT_AFFINITY=2.0
FYP_WEIGHT_POPULARITY=0.5
FYP_RECENCY_TAU_HOURS=24
FYP_RECENCY_WINDOW_DAYS=30
FYP_AFFINITY_DIRECT=1.0
FYP_AFFINITY_FOF=0.1
FYP_DEFAULT_LIMIT=50
FYP_MAX_LIMIT=200

# --- Server ---
APP_HOST=0.0.0.0
APP_PORT=8000
UVICORN_WORKERS=2

# --- Logging ---
REQUEST_LOG_PATH=requests.log
LOG_LEVEL=INFO
