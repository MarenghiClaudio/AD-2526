# =============================================================
# .env.master — VM master (PostgreSQL primary)
# Copia come .env nella root del progetto sul master.
# =============================================================

POSTGRES_DB=ad
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
REPLICATION_PASSWORD=replpassword

DB_HOST=postgres
DB_PORT=5432
DB_NAME=ad
DB_USER=postgres
DB_PASSWORD=admin
DB_SCHEMA=ad
DB_POOL_MIN_CONN=2
DB_POOL_MAX_CONN=10
