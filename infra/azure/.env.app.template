# =============================================================
# .env.app.template — VM applicativa (backend + Redis + Locust)
# Copia come .env nella root del progetto sulla VM app.
#
# Da modificare:
#   MASTER_IP     → IP privato della VM master
#   DB_HOSTS_READ → IP privati delle 3 repliche (comma-separated)
#   CACHE_STRATEGY → strategia per il run corrente
# =============================================================

# --- Master PostgreSQL (scritture) ---
MASTER_IP=10.0.0.4

# --- Repliche PostgreSQL (letture, round-robin) ---
DB_HOSTS_READ=10.0.0.5,10.0.0.6,10.0.0.7

# --- Credenziali DB ---
DB_USER=postgres
DB_PASSWORD=admin
DB_NAME=ad
DB_SCHEMA=ad
DB_PORT=5432
DB_POOL_MIN_CONN=2
DB_POOL_MAX_CONN=30

# --- Strategia di caching ---
# Cambia questo valore tra un run e l'altro per confrontare le strategie:
#   no_cache | cache_aside | write_through | push_feed | hybrid
CACHE_STRATEGY=cache_aside

# --- Redis (locale alla VM app) ---
REDIS_PORT=6379
REDIS_DB=0

# --- TTL cache (secondi) ---
CACHE_TTL_USER=300
CACHE_TTL_POST=300
CACHE_TTL_TIMELINE=60
CACHE_TTL_FEED=60
CACHE_TTL_FEED_FOF=60

# --- FYP ranking ---
FYP_WEIGHT_RECENCY=1.0
FYP_WEIGHT_AFFINITY=2.0
FYP_WEIGHT_POPULARITY=0.5
FYP_RECENCY_TAU_HOURS=24
FYP_RECENCY_WINDOW_DAYS=30
FYP_AFFINITY_DIRECT=1.0
FYP_AFFINITY_FOF=0.1
FYP_DEFAULT_LIMIT=50
FYP_MAX_LIMIT=200

# --- Server ---
APP_HOST=0.0.0.0
APP_PORT=8000
UVICORN_WORKERS=4

# --- Logging ---
REQUEST_LOG_PATH=requests.log
LOG_LEVEL=INFO
